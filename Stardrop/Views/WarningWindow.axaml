<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stardrop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
		xmlns:models="using:Stardrop.Models.Data"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
        x:Class="Stardrop.Views.WarningWindow"
		x:DataType="vm:WarningWindowViewModel"
        Title="Warning"
        MinWidth="300"
        MinHeight="150"
        Width="{Binding WindowWidth}"
		SizeToContent="Height"
        Background="{DynamicResource ThemeBackgroundBrush}"
        WindowDecorations="None"
        Icon="/Assets/icon.ico">

	<Window.Styles>
		<Style Selector="Button:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ThemeForegroundBrush}"/>
		</Style>
		<Style Selector="Button:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource HighlightBrush}"/>
		</Style>
		<Style Selector="ProgressBar /template/ TextBlock">
			<Setter Property="FontWeight" Value="ExtraBold"/>
		</Style>
		<!--Links sit inline with the message text, so the button chrome is stripped back down to plain text-->
		<Style Selector="Button.hyperlink">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}"/>
		</Style>
		<Style Selector="Button.hyperlink /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="TextBlock.Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.hyperlink:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="TextBlock.Foreground" Value="{DynamicResource HighlightForegroundBrush}"/>
		</Style>
	</Window.Styles>

	<Window.Resources>
		<StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="ThemeForegroundHighBrush"/>
	</Window.Resources>

	<Border BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="10" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">
				<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0 35 0 20" MaxHeight="300">
					<Panel>
						<TextBlock IsVisible="{Binding !IsRichTextVisible}" Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="{Binding MessageHorizontalAlignment}" TextAlignment="{Binding MessageTextAlignment}"/>
						<!--The segment based display, used when the message may contain links. Avalonia 0.10 has no inline runs, so each line is laid out as its own wrapping panel of words-->
						<ItemsControl IsVisible="{Binding IsRichTextVisible}" ItemsSource="{Binding WarningLines}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="models:RichTextLine">
									<Grid ColumnDefinitions="Auto,*">
										<Border Grid.Column="0" Width="{Binding IndentWidth}"/>
										<ItemsControl Grid.Column="1" ItemsSource="{Binding Segments}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel Orientation="Horizontal"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="models:RichTextSegment">
													<Panel>
														<TextBlock IsVisible="{Binding !IsLink}" Text="{Binding Text}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}"/>
														<Button IsVisible="{Binding IsLink}" Classes="hyperlink" ToolTip.Tip="{Binding Uri}" Command="{ReflectionBinding  $parent[Window].DataContext.OpenLink}" CommandParameter="{Binding Uri}">
															<TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextDecorations="Underline" MaxWidth="{ReflectionBinding $parent[Window].DataContext.LinkMaxWidth}"/>
														</Button>
													</Panel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Panel>
				</ScrollViewer>
				<ProgressBar Grid.Row="1" IsVisible="{Binding IsProgressBarVisible}" Margin="0 0 0 10" Height="20"
							  Minimum="0" Value="{Binding ProgressBarValue}"
							  Foreground="{DynamicResource HighlightBrush}"
							  ShowProgressText="True"/>
				<Button Grid.Row="2" IsVisible="{Binding IsButtonVisible}" Margin="0 0 0 30" IsEnabled="{Binding IsButtonEnabled}" Name="unlockButton" IsCancel="True" Content="{Binding ButtonText}" Click="UnlockButton_Click" HorizontalAlignment="Center" BorderBrush="{DynamicResource HighlightBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" Background="Transparent"/>
			</Grid>
		</Grid>
	</Border>
</Window>
